# Acrescente ao .env do TCC Claude depois da migração para Supabase
# (Project Settings > Database > Connection string > "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# As variáveis DB_HOST/DB_USER/DB_PASS/DB_NAME deixam de ser usadas.
