DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

JWT_SECRET=troque_por_uma_chave_secreta_longa

RECAPTCHA_SECRET=sua_secret_key_do_google_recaptcha

# Cosmos Bluesoft — busca de produtos por EAN/GTIN (https://cosmos.bluesoft.com.br)
# Sem este token, o sistema usa Open Food Facts como fonte alternativa.
COSMOS_TOKEN=

PORT=3001



# Recuperação de senha: envio do código por e-mail (https://resend.com)
# Sem domínio verificado no Resend, só é possível enviar para o e-mail da própria conta Resend,
# e EMAIL_FROM precisa ser onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
