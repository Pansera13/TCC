# Copia este arquivo como .env e preencha com valores reais (nunca commitar .env)

# Conexão com o banco PostgreSQL (Supabase)
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:SENHA_AQUI@db.PROJETO.supabase.co:5432/postgres

# Segredo para assinar tokens JWT de sessão (string aleatória longa)
JWT_SECRET=troque-por-uma-string-secreta-e-longa

# Segredo para tokens de recuperação de senha (pode ser diferente do JWT_SECRET)
JWT_RESET_SECRET=troque-por-outra-string-secreta

# Chave da API do Resend para envio de e-mails
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Chave secreta do reCAPTCHA v2 (backend). Deixe em branco para desabilitar o CAPTCHA.
RECAPTCHA_SECRET=

# Remetente dos e-mails (sem domínio verificado use onboarding@resend.dev)
EMAIL_FROM=StockFlow <onboarding@resend.dev>

# Origens permitidas para CORS (separadas por vírgula). Deixe em branco para permitir localhost e redes RFC 1918.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Token da API Cosmos (Bluesoft) para consulta de código de barras.
# Deixe em branco para pular a Cosmos e usar somente Open Food Facts.
COSMOS_TOKEN=

# Porta em que o servidor Django escutará (padrão: 3002)
PORT=3002

# Django SECRET_KEY (gerada automaticamente se ausente; defina em produção)
DJANGO_SECRET_KEY=troque-por-chave-django-segura
