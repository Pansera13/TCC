# Só o README e a pasta TCC-Claude da raiz vão para o GitHub.
# Todo o resto (Obsidian "TCC", logs, imagens soltas, ferramentas) fica só na sua máquina.
/*
!/.gitignore
!/README.md
!/TCC-Claude/
!/.github/

# Dentro das pastas permitidas, nunca versionar:

# Segredos (só o .env.example, com valores falsos)
.env
.env.*
!.env.example

# Chaves, certificados e dumps/backups do banco (contêm segredos ou dados de clientes)
*.pem
*.key
*.p12
*.pfx
*.dump
*.backup
*.bak
stockflow_backup_*
*.sqlite3

# Cobertura de testes gerada localmente
.coverage
htmlcov/

# Dependências e builds
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc

# Logs e temporários
*.log
*.tmp
.DS_Store
Thumbs.db

# Configuração local do Claude Code e do Obsidian
**/.claude/settings.local.json
.obsidian/

# Cache e logs do plugin Playwright
.playwright-mcp/
