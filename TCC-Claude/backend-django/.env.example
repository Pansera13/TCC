# Copia este arquivo como .env e preencha com valores reais (nunca commitar .env)

# Conexão com o banco PostgreSQL (Supabase)
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:SENHA_AQUI@db.PROJETO.supabase.co:5432/postgres

# Segredo para assinar tokens JWT de sessão (string aleatória longa)
JWT_SECRET=troque-por-uma-string-secreta-e-longa

# Segredo para tokens de recuperação de senha (pode ser diferente do JWT_SECRET)
JWT_RESET_SECRET=troque-por-outra-string-secreta

# Chave da API do Resend para envio de e-mails
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Chave secreta do reCAPTCHA v2 (backend). Deixe em branco para desabilitar o CAPTCHA.
RECAPTCHA_SECRET=

# Remetente dos e-mails (sem domínio verificado use onboarding@resend.dev)
EMAIL_FROM=StockFlow <onboarding@resend.dev>

# Origens permitidas para CORS (separadas por vírgula). Deixe em branco para permitir localhost e redes RFC 1918.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Token da API Cosmos (Bluesoft) para consulta de código de barras.
# Deixe em branco para pular a Cosmos e usar somente Open Food Facts.
COSMOS_TOKEN=

# Porta em que o servidor Django escutará (padrão: 3002)
PORT=3002

# Django SECRET_KEY (gerada automaticamente se ausente; defina em produção)
DJANGO_SECRET_KEY=troque-por-chave-django-segura

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Máximo de falhas de login antes do bloqueio (por IP e por identificador)
LOGIN_MAX_FALHAS=5
# Janela de contagem de falhas em segundos (padrão: 15 min)
LOGIN_JANELA_SEGUNDOS=900
# Duração do bloqueio após exceder o limite (padrão: 15 min)
LOGIN_BLOQUEIO_SEGUNDOS=900

# Máximo de tentativas de cadastro por IP por hora
REGISTER_MAX_FALHAS=10
REGISTER_JANELA_SEGUNDOS=3600
REGISTER_BLOQUEIO_SEGUNDOS=3600

# Proxy reverso confiável: define se X-Forwarded-For é usado para o IP do cliente.
# AVISO: ative somente se houver um proxy reverso (nginx, Cloudflare, etc.) na frente
# do servidor. Sem proxy, qualquer cliente pode forjar o cabeçalho e burlar o rate limit.
# Valores: true | false (padrão: false)
TRUSTED_PROXY=false

# ── Cabeçalhos de segurança ───────────────────────────────────────────────────
# Modo de execução: false = seguro por padrão; true somente em desenvolvimento local
DEBUG=false

# Hosts permitidos pelo Django (separados por vírgula); padrão: localhost,127.0.0.1
# Em produção: defina o domínio real (ex.: api.seudominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# HSTS — Strict-Transport-Security (só ativo quando DEBUG=false)
# Subida gradual recomendada: 300 → 3600 → 86400 → 31536000 (1 ano, só após HTTPS estável)
# NÃO ative SECURE_HSTS_PRELOAD sem registrar o domínio deliberadamente no preload-list
SECURE_HSTS_SECONDS=300

# ── NF-e ─────────────────────────────────────────────────────────────────────
# Tamanho máximo do arquivo XML em bytes (padrão: 2097152 = 2 MB)
NFE_MAX_SIZE_BYTES=2097152
# Número máximo de itens <det> por NF-e (padrão: 500)
NFE_MAX_ITENS=500
# Rate limit: máximo de importações por usuário/IP na janela (padrão: 20 por 10 min)
NFE_MAX_IMPORTACOES=20
NFE_JANELA_SEGUNDOS=600
NFE_BLOQUEIO_SEGUNDOS=600
